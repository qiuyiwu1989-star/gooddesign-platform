{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gooddesign.local/schema/source-asset-1.0.json",
  "title": "GoodDesign Source Asset 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_id", "project_id", "title", "read_scope", "review_status", "project_relation", "relation_basis", "original_verified", "assets"],
  "properties": {
    "schema": {"const": "gooddesign-source-asset-1.0"},
    "source_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "project_id": {"type": "string", "pattern": "^[0-9]{4}-[a-z]?[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "read_scope": {"type": "string", "minLength": 1},
    "review_status": {"type": "string", "minLength": 1},
    "project_relation": {"enum": ["project_source", "related_technology", "shared_reference", "unresolved"]},
    "relation_basis": {"type": "string", "minLength": 1},
    "original_verified": {"const": false, "description": "自动投影不得把登记的 original 升格为已确认原件。"},
    "origin": {"type": ["object", "null"]},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["original", "readable", "chunks", "image"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
