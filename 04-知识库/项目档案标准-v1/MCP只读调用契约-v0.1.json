  "tools": [
    {
      "name": "gd_search_projects",
      "description": "按身份、行业、功能或问题查找授权范围内的项目候选。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "reading_scope": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "locator",
                "reading_scope"
              ]
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "NOT_FOUND",
                      "REVISION_NOT_FOUND",
                      "FORBIDDEN",
                      "INVALID_ARGUMENT",
                      "CURSOR_INVALID",
                      "INTEGRITY_ERROR"
                    ]
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              }
            ]
          }
        },
        "required": [
          "project_id",
          "revision",
          "schema_version",
          "status",
          "data",
          "citations",
          "next_cursor",
          "error"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
