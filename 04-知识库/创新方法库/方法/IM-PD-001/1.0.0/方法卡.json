      },
      {
        "source_id": "SRC-NASA",
        "publisher": "NASA",
        "title": "Systems Engineering Handbook · 4.3 Logical Decomposition",
        "url": "https://www.nasa.gov/reference/4-3-logical-decomposition/",
        "locator": "4.3.1.2.1–4.3.1.2.2",
        "basis": "将目标和要求分解为功能，并明确功能之间的接口。",
        "rights": "链接引用；未复制原书或图",
        "accessed_at": "2026-10-21",
        "read_scope": "relevant_full_web_sections"
      }
    ],
    "original_authors": [
      "Design Council",
      "NASA"
    ],
    "adaptations": [
      "字段、操作步骤、证据标准、提问与检查规则由平台设计，不作为原作者逐字方法或官方认证版本",
      "用于案例回看时属于平台重构，不认定原研发团队采用本方法"
    ],
    "rights": "平台编写部分可用于本项目；外部原典依各自权利"
  },
  "purpose": "把企业愿望整理为对象、情境、目标、约束、成功口径与待确认的问题简报。",
  "stages": [
    "问题定义"
  ],
  "triggers": [
    "服务谁，处理什么对象？",
    "现状与基线有什么记录？",
    "哪些限制绝对不能改变？",
    "成功由什么指标和阈值判定？"
  ],
  "preconditions": [
    "用户/模拟任务"
  ],
  "exclusions": [
    "关键对象和目标未知时先追问",
    "紧急安全处置不能等候此研究流程",
    "本方法不替代用户验证或正式需求评审"
  ],
  "missing_input_questions": [
    "服务谁，处理什么对象？",
    "现状与基线有什么记录？",
    "哪些限制绝对不能改变？",
    "成功由什么指标和阈值判定？"
  ],
  "inputs": [
    {
      "key": "task",
      "label": "用户/模拟任务",
      "type": "object",
      "required": true,
      "missing_action": "ask_or_stop"
    },
    {
      "key": "project_context",
      "label": "项目知识背景",
      "type": "object",
      "required": false,
      "missing_action": "mark_unknown_and_limit_output"
    }
  ],
  "steps": [
    {
      "step_id": "IM-PD-001-S01",
      "title": "建立任务边界",
      "purpose": "建立任务边界",
      "operation": "明确谁在何处对什么对象完成什么工作，保留需求来源和模拟/真实标签。",
      "input_refs": [
        "task"
      ],
      "depends_on": [],
      "output_key": "task_boundary",
      "knowledge_query_ids": [],
      "checks": [
        "对象和目标清楚",
        "不把模拟输入写成访谈事实"
      ],
      "stop_condition": "缺少必需信息则记录待补，不填造数据"
    },
    {
      "step_id": "IM-PD-001-S02",
      "title": "区分症状、目标和原因假设",
      "purpose": "区分症状、目标和原因假设",
      "operation": "记录观察到的现象、希望获得的效果、对原因的猜测；没有企业数据时症状和基线留空。",
      "input_refs": [
        "task",
        "task_boundary"
      ],
      "depends_on": [
        "IM-PD-001-S01"
      ],
      "output_key": "problem_layers",
      "knowledge_query_ids": [],
      "checks": [
        "原因不是事实标签",
        "不把已有技术方案写成唯一目标"
      ],
      "stop_condition": "缺少必需信息则记录待补，不填造数据"
    },
    {
      "step_id": "IM-PD-001-S03",
      "title": "检查约束与知识参照",
      "purpose": "检查约束与知识参照",
      "operation": "核对硬约束、可变条件和未知；从源项目提取问题/功能结构作参考，不移植其数值。",
      "input_refs": [
        "task",
        "problem_layers"
      ],
      "depends_on": [
        "IM-PD-001-S02"
      ],
      "output_key": "constraint_map",
      "knowledge_query_ids": [
        "PD-Q1"
      ],
      "checks": [
        "硬约束优先",
        "来源目标与企业目标分开"
      ],
      "stop_condition": "缺少必需信息则记录待补，不填造数据"
    },
    {
      "step_id": "IM-PD-001-S04",
      "title": "定义成功口径与追问",
      "purpose": "定义成功口径与追问",
      "operation": "将成功拆成独立可测量维度：对象、指标、单位、工况、阈值与测量方法。缺少阈值则记录确认责任。",
      "input_refs": [
        "constraint_map"
      ],
      "depends_on": [
        "IM-PD-001-S03"
      ],
      "output_key": "success_and_questions",
      "knowledge_query_ids": [
        "PD-Q2"
      ],
      "checks": [
        "未知不补0",
        "样品质量不能替代层序保持",
        "无基线不计算提升"
      ],
      "stop_condition": "缺少必需信息则记录待补，不填造数据"
    },
    {
      "step_id": "IM-PD-001-S05",
      "title": "形成问题简报与阶段许可",
      "purpose": "形成问题简报与阶段许可",
      "operation": "汇总目标、边界、缺口和关键假设；输入足够可做概念探索，缺工况/阈值则禁止定型和效果承诺。",
      "input_refs": [
        "task_boundary",
        "problem_layers",
        "constraint_map",
        "success_and_questions"
      ],
      "depends_on": [
        "IM-PD-001-S04"
      ],
      "output_key": "problem_brief",
      "knowledge_query_ids": [],
      "checks": [
        "每项要求可回溯需求",
        "明确允许与禁止的输出"
      ],
      "stop_condition": "缺少必需信息则记录待补，不填造数据"
    }
  ],
  "knowledge_queries": [
    {
      "query_id": "PD-Q1",
      "purpose": "发现问题结构而非行业名称相似",
      "entity": "problem",
      "fields": [
        "title",
        "scenario",
        "goal",
        "constraints"
      ],
      "evidence_requirement": "区分原文事实、平台分析和目标假设；结论需定位块和版本",
      "exclude": [
        "整器全部技术",
        "目标领域未验证结论"
      ],
      "context_priority": [
        "硬约束",
        "问题/功能",
        "机制与边界",
        "验证",
        "原文"
      ],
      "limit": 3
    },
    {
      "query_id": "PD-Q2",
      "purpose": "检查指标对象与工况口径",
      "entity": "metric",
      "fields": [
        "subject",
        "value_kind",
        "unit",
        "conditions",
        "qualifier"
      ],
      "evidence_requirement": "区分原文事实、平台分析和目标假设；结论需定位块和版本",
      "exclude": [
        "任务总量替代子系统结果",
        "地面参数当企业默认值"
      ],
      "context_priority": [
        "硬约束",
        "问题/功能",
        "机制与边界",
        "验证",
        "原文"
      ],
      "limit": 3
    }
  ],
  "outputs": [
    {
      "key": "problem_brief",
      "label": "问题简报",
      "kind": "analysis"
    },
    {
      "key": "success_and_questions",
      "label": "成功指标与追问",
      "kind": "provisional_requirements"
    }
  ],
  "quality_checks": [
    "目标不预设唯一解",
    "事实/假设/未知可区分",
    "硬约束和验收口径可追溯"
  ],
  "failure_cases": [
    "把我想要某机器人直接当完整问题",
    "没有基线却输出效率提升",
    "把来源约束误当企业已确认限制"
  ],
  "composable_with": [
    {
      "next_method": "IM-FA-001",
      "binding": {
        "problem_brief": "problem_brief"
      },
      "gate": "至少具备对象、目标和初步边界"
    }
  ],
  "evaluations": [
    {
      "id": "IM-PD-001-EVAL-01",
      "scenario": "关键输入缺失",
      "expected": "追问或停止，保留未知"
    },
    {
      "id": "IM-PD-001-EVAL-02",
      "scenario": "嫦娥→工业颗粒材料取样模拟任务",
      "expected": "原文事实/平台解释/目标假设分层，输出可追溯"
    },
    {
      "id": "IM-PD-001-EVAL-03",
      "scenario": "目标硬约束冲突",
      "expected": "相关方向排除或降为条件性，不用案例相似覆盖约束"
    }
  ],
  "review_status": "platform_structure_reviewed_not_method_expert_certified",
  "validation_status": "engineering_effect_not_validated",
  "change_log": [
    {
      "version": "1.0.0",
      "date": "2026-10-21",
      "reason": "首批可执行方法卡，验证与项目库的证据联动"
    }
  ]
}
