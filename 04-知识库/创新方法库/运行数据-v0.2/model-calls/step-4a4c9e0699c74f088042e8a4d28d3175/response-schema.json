{
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "task_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "PrototypePlan"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "assumption",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "minItems": 0,
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "payload": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "learning_goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "minItems": 1,
          "maxItems": 200
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "observable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "unit_or_scale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              }
            },
            "required": [
              "id",
              "observable",
              "unit_or_scale",
              "criterion"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200
        },
        "uncovered_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "planned"
          ]
        }
      },
      "required": [
        "hypothesis",
        "learning_goal",
        "scope",
        "procedure",
        "measurements",
        "uncovered_questions",
        "execution_status"
      ],
      "additionalProperties": false
    }
