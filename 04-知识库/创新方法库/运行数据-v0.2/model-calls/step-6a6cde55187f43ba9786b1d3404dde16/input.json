    "method": {
      "schema_version": "method-dossier-1.0",
      "research_id": "R17",
      "method_id": "IM-ML-017",
      "version": "0.1.0",
      "name": "形态学分析",
      "english_name": "Morphological Analysis",
      "kind": "method",
      "category": "B功能分析与概念生成",
      "lineage": [
        "形态学研究",
        "系统化工程设计"
      ],
      "aliases": [],
      "summary": "把子功能或问题维度的候选状态显式列出，通过一致性检查形成可追溯的概念组合。",
      "content_status": "substantive_draft",
      "execution_status": "documented_not_runtime_integrated",
      "review_status": "not_expert_reviewed",
      "validation_status": "not_engineering_validated",
      "sections": {
        "identity": "形态学分析源于Fritz Zwicky的广义形态研究，Tom Ritchey进一步发展了面向复杂、非量化问题的GMA与交叉一致性分析。本档案讨论工程概念阶段的子功能—解法表，并借用GMA的一致性思想。两者是有亲缘的用法，不等于同一套完整软件或统一算法。采用的是网页所述概念及平台操作适配，未复制专用工具。",
        "problem": "设计团队常把现有机构当作问题本身，只改变尺寸或外观，因而错过其他作用原理。形态学分析把“必须完成的作用”和“怎样实现”分开：例如输送、定位、夹持、释放各自可能有不同解法。它处理的是概念组合空间，不负责发现真实用户需求，也不替代已定原理后的精确参数优化。如果功能拆分不合理，组合表越大反而越容易产生伪方案。",
        "principle": "方法先定义维度和候选值，再考察组合之间是否一致。工程应用中可把维度取为子功能、候选值取为实现原理。每一列选项不只写零件名，还写输入输出和作用条件。交叉一致性是在判断条件能否共存，不直接表示因果。平台把逻辑冲突、实证限制、用户硬约束和未知分别保存；不能因为某方案不受偏爱，就把它写成物理上不可能。成对相容也不足以证明多部件整体可行。",
        "applicability": "适合已能说明目标功能、允许更换技术路线、又存在若干可选原理的概念阶段。至少要知道哪些功能不可丢失、系统内外边界和关键接口。对于只需调整一个已成熟机构尺寸的任务，应先考虑分析和优化。若材料、尺度、动力或安全要求未知，仍可做初步概念枚举，但兼容结论必须写成待验证；若对象和目标都未知，应返回问题定义，不用随机组合制造热闹。",
        "interpretation": "有用的产物不是一个巨大排列清单，而是每条保留路线的功能分配、接口解释、出处、排除理由和未知项。读者应能复查某一组合为什么留下、删去哪个约束会多出什么路线。组合数量只是形式空间大小，不是创新性、质量或成功率。没有统一的工程最优评分，不能因为一种组合涉及更多新技术就给它更高分；筛选准则应从任务要求另行建立。",
        "example": "教学演示：探索一个物件夹持工具，假设必要功能为定位、产生夹持作用和释放，真实载荷、材料、节拍均未知。第1步产出功能边界；第2步分别列基准定位/自定心、手动螺旋/气动、反向释放/弹性复位等概念方向。第3步发现目标气源未知，且弹性复位与持续保持的关系尚未说明，记录unknown而非通过。第4步保留手动与气动两条结构待细化路线，不宣称已可制造。第5步输出补查载荷、空间、接触材料和保持条件的任务，再进入比较。这里没有真实企业或实测效果。 补充一条可跟随组合：在“低速、允许手动、固定形状工件”的教学假设下，固定基准定位＋手动螺旋夹紧＋反向旋松释放，三者在作用原理层面可连接，作为组合M1保留；这不是载荷和寿命已合格。明确排除组合M2：仅有单向气缸夹紧、无螺旋传动，却要求靠反向旋松同一传动件释放；在该拓扑假设下没有对应自由度和载体，故为逻辑不相容。若新增螺旋机构，应登记成新的选项与组合，不能把M2原样改判通过。",
        "pitfalls": "误用一：把笛卡尔积所有排列叫创新方案，正确做法是先核接口再保留有意义的组合。误用二：把同一原理的不同尺寸当成不同技术路线，应标为参数变体。误用三：把未知兼容性自动当作通过，应显示缺失条件及验证方法。反例是只允许更换某零件公差而不允许改机构的任务，此时大范围组合会违反任务边界，应换成参数或公差分析。",
        "validation": "方法执行检查关注维度定义是否清晰、选项是否混层、冲突是否有依据、候选路线是否能说明全功能链。工程验证则要看实际模型、运动干涉、载荷、材料与制造条件，不能由一张形态学表证明。可用明确冲突输入检查程序是否剔除，用未知接口输入检查是否保留unknown；但软件筛选通过只说明规则执行一致。没有几何或求解器时，只输出概念与验证问题。",
        "adaptation": "原典支持维度、状态、组合空间与交叉一致性等概念。本平台将其落实成问题简报、功能选项表、兼容日志和后续输入包；三态检查、证据字段、工程接口清单与教学例子都是平台适配，不作为Zwicky或Ritchey逐字流程。未来引擎可以从项目库补选项，但每个原理都应带源条件，不能把案例标题相似当作接口兼容。",
        "gaps": "已核读Ritchey网页的定义、形态空间和CCA相关段落，未取得工程教材完整概念设计章节，也未采用其专用GMA软件。本条可供有边界的概念研究，尚缺真实企业任务、工程兼容性复核和方法效果评价。后续需要选择一个资料充分的机械设计过程，对功能拆分、被排除路线和验证结果作可追溯回看；本档案不认定任何获奖团队曾实际使用此法。"
      },
