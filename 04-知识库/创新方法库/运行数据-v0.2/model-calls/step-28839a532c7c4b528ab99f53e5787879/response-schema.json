{
  "type": "object",
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "task_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "VerificationPlan"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "\\S"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "assumption",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "minItems": 0,
            "maxItems": 200
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
      },
      "minItems": 0,
      "maxItems": 200
    },
    "payload": {
      "type": "object",
      "properties": {
        "requirements_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "verification",
                  "validation"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "inspection",
                  "analysis",
                  "demonstration",
                  "test"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000,
                "pattern": "\\S"
              },
              "configuration": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000,
                "pattern": "\\S"
              },
              "evidence_status": {
                "type": "string",
                "enum": [
                  "none",
                  "planned"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "minItems": 0,
                "maxItems": 200
              }
            },
            "required": [
              "requirement_id",
              "purpose",
              "method",
              "criterion",
              "configuration",
              "evidence_status",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 200
        },
        "validation_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "uncovered_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "planned"
          ]
        }
      },
      "required": [
        "requirements_revision",
        "matrix",
        "validation_questions",
        "uncovered_requirements",
        "execution_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifact_id",
    "revision",
    "task_id",
    "task_revision",
    "type",
    "scope",
    "conditions",
    "evidence_refs",
    "payload"
  ],
  "additionalProperties": false
}
