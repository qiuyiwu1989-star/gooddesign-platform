        "type": "ProblemBrief",
        "scope": "依据所供研究任务整理问题框架与15项拟议要求，为后续功能分析和机械改进候选路线研究提供输入。当前不确定产品架构、不推荐具体方案、不建立客户批准基线；所有验证描述均为计划，未执行。",
        "conditions": [
          {
            "id": "C01",
            "text": "任务输入明确为研究提案，需求快照未获客户批准。",
            "kind": "fact",
            "evidence_refs": []
          },
          {
            "id": "C02",
            "text": "本次未提供项目证据；快照中的来源编号不能在本次证据集中解析，故不作为项目事实依据引用。",
            "kind": "fact",
            "evidence_refs": []
          },
          {
            "id": "C03",
            "text": "hard=true沿用输入的硬要求提议，不代表客户已批准；hard=null表示硬度尚未确定。",
            "kind": "fact",
            "evidence_refs": []
          }
        ],
        "evidence_refs": [],
        "payload": {
          "actor": "拟涉及胶园经营者、操作员、收胶人员、维护人员、加工方、农艺人员及设备研发人员；实际参与者、代表性与确认权限待核实。",
          "object": "割胶机器人改进研究：共同研究有效产出、胶乳洁净与树体保护之间的关系；现场缺口、成因及影响程度尚未证实。",
          "boundary": "研究提案，未客户确认。保留手持、固定及移动架构的探索空间；局部改造仅为待研究路径，不构成架构选择。关键使用对象、工况与安全边界明确前，不确定产品规格或判定方案可接受。本文不构成工程验证、专家批准或产品验收。",
          "desired_outcome": "形成可验证的机械改进候选路线，并明确其适用条件、拟议要求、待补证问题和后续验证方向。",
          "requirements": [
            {
              "id": "N01",
              "text": "拟议要求：保护树体及长期割面资源，避免以伤树或过度耗皮换取短期增产。",
              "hard": true,
              "acceptance": "在定义明确的深度、耗皮与损伤口径下测量，并安排跨周期跟踪；阈值待客户及农艺人员确认",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N02",
              "text": "拟议要求：适应树干曲率与树皮差异，区分表面跟随能力与真实限深能力。",
              "hard": true,
              "acceptance": "对曲率、厚度和旧割面分层试验；刀位移、剩余树皮及损伤分别记录；允许误差待定",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N03",
              "text": "拟议要求：隔离新切屑与胶乳，降低杂质混入和清理负担。",
              "hard": true,
              "acceptance": "定义污染采样方法，比较杂质、损失胶乳及清理时间；限值待下游确认",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N04",
              "text": "拟议要求：处理已有胶线、刀面黏附与排屑堵塞。",
              "hard": null,
              "acceptance": "记录堵塞、停机、清理及重启；阈值待定，不能以空载切削代替",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N05",
              "text": "拟议要求：提高单位人时的合格干胶产出。",
              "hard": null,
              "acceptance": "同时记录定位、安装、切割、转场、收胶、清理、故障、人机协作时间及干胶口径；目标待实测",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N06",
              "text": "拟议要求：将关键操作判断转为可检查的设置与反馈，降低对熟练工的依赖。",
              "hard": null,
              "acceptance": "新手与熟练人员分组，记录培训、误操作、返工与接管，不能仅调查喜欢程度",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N07",
              "text": "拟议要求：失去接触、堵转或感知异常时停止危险切削，支持安全退让、人工接管及异常记录。",
              "hard": true,
              "acceptance": "在受控环境验证急停、断电、传感异常、退出路径与复位条件；先安全审核",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N08",
              "text": "拟议要求：识别不适合作业的环境条件，并支持雨水、弱光条件下的作业安排。",
              "hard": null,
              "acceptance": "现场调查光照、湿度、雨后割面和允许时段；雨水防护不等于雨中可割",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N09",
              "text": "拟议要求：支持刀具、导向件和胶乳接触区的清洗维护及耗材更换。",
              "hard": null,
              "acceptance": "计时清洗、换刀、复装校准，跟踪磨损和积胶；材料与费用未知",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N10",
              "text": "拟议要求：使改进路线与目标胶园及装备接口相适配。",
              "hard": null,
              "acceptance": "调查树距、坡度、挂载接口、供电与收胶流程，再确定目标平台",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N11",
              "text": "拟议要求：保留可追溯的作业与验收数据。",
              "hard": null,
              "acceptance": "记录树ID、时间、工具版本、工况、异常和数据缺失，不编造客户已有数字化基础",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N12",
              "text": "拟议要求：支持包含人工、维护、停机、折旧及树体影响的全生命周期经济性比较。",
              "hard": null,
              "acceptance": "采集实际成本与利用率，用情景区间比较；不输出无数据ROI",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N13",
              "text": "拟议要求：保护胶乳有效品质与收集率，避免以增加水分或牺牲品质形成表面增产。",
              "hard": true,
              "acceptance": "由加工方确认干胶含量、杂质和收集损失测量方法；不能以初始流速代替季节产量",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N14",
              "text": "拟议要求：对厚度未知、旧伤、树结或状态异常等不适用树株停止作业或转人工处理。",
              "hard": true,
              "acceptance": "定义适用树株与例外规则，记录覆盖率与误拒绝；识别能力需验证",
              "status": "proposed",
              "evidence_refs": []
            },
            {
              "id": "N15",
              "text": "拟议要求：支持分阶段、可撤销的局部改造研究，再决定整机投入。",
              "hard": null,
              "acceptance": "完成接口勘察与局部验证，不把试验优先顺序解释成已选定产品架构",
              "status": "proposed",
              "evidence_refs": []
            }
          ],
          "conditions": [
            {
              "id": "PC01",
              "text": "出胶效率、洁净与树体保护是输入提出的共同研究方向，其现场表现及冲突程度尚未取得项目证据。",
              "kind": "unknown",
