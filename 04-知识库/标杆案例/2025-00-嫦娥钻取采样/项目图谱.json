    {
      "id": "C01",
      "type": "source_statement",
      "label": "项目为嫦娥五/六号月球钻取采样方法及系统设计；2025年第十届金奖，官方编号12025070107。"
    },
    {
      "id": "C02",
      "type": "source_statement",
      "label": "获奖完成单位：哈尔滨工业大学、北京圣视环宇科技有限公司。"
    },
    {
      "id": "C03",
      "type": "source_statement",
      "label": "奖项项目介绍将承研国家任务起点记为2011年。"
    },
    {
      "id": "C04",
      "type": "source_statement",
      "label": "未知月壤、极端环境、重量/功耗/空间与通信限制共同约束设计。"
    },
    {
      "id": "C05",
      "type": "source_statement",
      "label": "采用双管与内翻软袋组织取芯，以减少样心相对滑移并保留层序。"
    },
    {
      "id": "C06",
      "type": "source_statement",
      "label": "嫦娥五号钻取样品260克。"
    },
    {
      "id": "C07",
      "type": "source_statement",
      "label": "嫦娥六号钻取样品320克。"
    },
    {
      "id": "C08",
      "type": "source_statement",
      "label": "嫦娥五号任务样品总量约1731克。"
    },
    {
      "id": "C09",
      "type": "source_statement",
      "label": "嫦娥六号任务样品总量1935.3克。"
    },
    {
      "id": "C10",
      "type": "source_statement",
      "label": "2015年研究在HIT-LS1#模拟物与HIT-2钻具条件下，取心率模型预测与试验的平均误差率小于5%。"
    },
    {
      "id": "C11",
      "type": "source_statement",
      "label": "哈工大介绍其遥测驱动的智能支持与反演系统服务于嫦娥六号钻取作业决策。"
    },
    {
      "id": "C12",
      "type": "source_statement",
      "label": "哈工大介绍高分子团队研制绳与袋一体化取芯软袋，支持样品封装。"
    },
    {
      "id": "C13",
      "type": "source_statement",
      "label": "哈工大介绍钻取地面支持平台用于在线监视、决策支持及全流程演练。"
    },
    {
      "id": "C14",
      "type": "source_statement",
      "label": "校方人物报道回顾2009—2020年的月表采样设计与试验积累。"
    },
    {
      "id": "C15",
      "type": "source_statement",
      "label": "项目官网自述授权发明专利50件、登记软著1项、专著2部、SCI/EI论文60篇。"
    },
    {
      "id": "C16",
      "type": "source_statement",
      "label": "项目官网陈述相关方法已用于后续月球和火星采样任务的研究。"
    },
    {
      "id": "C17",
      "type": "source_statement",
      "label": "CN107503698B中文授权文本首页记载权利人为哈尔滨工业大学，授权公告日2020-06-23。"
    },
    {
      "id": "C18",
      "type": "source_statement",
      "label": "CN109323884B中文授权文本首页记载权利人为哈尔滨工业大学，授权公告日2021-02-19。"
    },
    {
      "id": "C19",
      "type": "source_statement",
      "label": "哈工大2024年新闻将月背采样多学科团队牵头人记为邓宗全。"
    },
    {
      "id": "C20",
      "type": "source_statement",
      "label": "2015年模拟试验研究的工况包含50、90、150、210、250 r/min回转转速，以及50、90、130、170、210 mm/min进尺速度。"
    },
    {
      "id": "C21",
      "type": "source_statement",
      "label": "校方报道2009年开展采样封装专项论证，2011—2013年完成原理与集成验证研究。"
    },
    {
      "id": "C22",
      "type": "source_statement",
      "label": "校方报道2012—2020年联合研制钻取子系统，并介绍2020-12-02月面作业环节。"
    },
    {
      "id": "C23",
      "type": "source_statement",
      "label": "公开报道记载人工夯实和压力机加压未达制备目标，改进工艺细节未公开。"
    },
    {
      "id": "C24",
      "type": "source_statement",
      "label": "论文比较外伸管与无外伸管钻头，指出取芯应力与岩石钻进接触面积之间的取舍。"
    },
    {
      "id": "C25",
      "type": "source_statement",
      "label": "论文表1的平均误差率为4.31%；模型对剧烈振动冲击工况的适用性有限。"
    },
    {
      "id": "C26",
      "type": "source_statement",
      "label": "论文表1—3列示加载机构、钻进机构和钻具的部件参数。"
    },
    {
      "id": "C27",
      "type": "source_statement",
      "label": "论文表4列出两种控制方式各5次的地面取芯数据；保留原始质量和长度，不外推飞行收益。"
    },
    {
      "id": "C28",
      "type": "source_statement",
      "label": "论文结论报告五号和六号钻进有效深度分别约1009 mm与1035 mm。"
    },
    {
      "id": "C29",
      "type": "source_statement",
      "label": "冲击试验报告未闭环与PID闭环条件下稳定时间约30 s与17.8 s，峰值超调均约400 N。"
    },
    {
      "id": "C30",
      "type": "source_statement",
      "label": "论文作者称恒力载控制已用于五号和六号月面采样；与获奖成果清单归属分开。"
    },
    {
      "id": "C31",
      "type": "source_statement",
      "label": "模拟月壤恒定400 N工况：5组均值曲线的超调区间−22.8至+15.6 N，启动至稳定约4.6 s。"
    },
    {
      "id": "C32",
      "type": "source_statement",
      "label": "模拟月壤斜坡目标工况：5组均值曲线的超调区间−14.8至+23.6 N，启动至稳定约3.1 s。"
    },
    {
      "id": "C33",
      "type": "source_statement",
      "label": "人造大理岩恒定400 N工况：5组均值曲线最大超调约92.1 N，稳定后−29.6至+6.4 N，启动至稳定约8.2 s。"
    },
    {
      "id": "C34",
      "type": "source_statement",
      "label": "人造大理岩斜坡目标工况：5组均值曲线最大超调约74.3 N，稳定后−18.3至+31.7 N，启动至稳定约7.4 s。"
    },
