    {
      "id": "P01-need",
      "type": "hypothetical_need",
      "label": "树形、刀具姿态和材料变化时，怎样控制切除量并约束伤树风险？"
    },
    {
      "id": "P01-proposal",
      "type": "proposed_solution",
      "label": "候选方向：以经校准的几何/切除量估计约束轨迹，辅以接触反馈和异常识别；内部余皮厚度需单独建立测量或校准依据。"
    },
    {
      "id": "P01-test",
      "type": "proposed_validation",
      "label": "先固定工件和末端，比较固定轨迹、接触反馈辅助、几何与接触信息融合三种研究方案。记录切除量误差、耗皮、损伤和异常恢复；验收阈值先确认。"
    },
    {
      "id": "P02-need",
      "type": "hypothetical_need",
      "label": "如何兼顾作业效率、有效切割与长期树体状态？"
    },
    {
      "id": "P02-proposal",
      "type": "proposed_solution",
      "label": "把刀具几何、姿态、进给和限位方式作为候选变量；在农艺底线内比较作业时间、耗皮、损伤和产胶，不以单次产胶量判最好。"
    },
    {
      "id": "P02-test",
      "type": "proposed_validation",
      "label": "比较几种候选刀具/限位与控制组合，按预先定义的多目标判据淘汰方案；保留失败及代价。"
    },
    {
      "id": "P03-need",
      "type": "hypothetical_need",
      "label": "怎样知道机器真的割得好，而不只是轨迹跟得好？"
    },
    {
      "id": "P03-proposal",
      "type": "proposed_solution",
      "label": "先做末端最小原型，验证测量与切割效果；再加入定位、跨树移动、环境及维护因素。每一步通过后再扩大范围。"
    },
    {
      "id": "P03-test",
      "type": "proposed_validation",
      "label": "为各层定义对象、对照、测量、阈值和未覆盖风险。末端台架、合适材料、农艺确认后的实树、长期作业分别留记录。"
    },
    {
      "id": "P04-need",
      "type": "hypothetical_need",
      "label": "都叫“采集”，是否可以直接用软袋取芯？"
    },
    {
      "id": "P04-proposal",
      "type": "proposed_solution",
      "label": "本次不采用直接机构迁移。若另有胶乳收集与污染控制需求，应作为独立问题研究，重新寻找证据。"
    },
    {
      "id": "P04-test",
      "type": "proposed_validation",
      "label": "重新确认目标；没有目标与机制对应关系时，不进入该机构路线试制。"
    }
