[Unit]
Description=Good Design original API
After=network.target
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/gooddesign.qiuyiwu.com/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3187
Environment=DATA_DIR=/var/lib/gooddesign
EnvironmentFile=/etc/gooddesign.env
ExecStart=/usr/bin/node /var/www/gooddesign.qiuyiwu.com/current/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gooddesign
[Install]
WantedBy=multi-user.target
