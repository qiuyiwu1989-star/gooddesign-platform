      "type": "PrototypePlan",
      "scope": "Host Agent研究草稿；客户型号、目标值、树体条件未确认；没有实验、专业审核或工程认证",
      "conditions": [],
      "evidence_refs": [],
      "payload": {
        "hypothesis": "在明确基准与安全边界后，机械参考/废物流分离/可退让监测的组合可能改善清洁与可靠性；其收益和树体影响目前未知",
        "learning_goal": "先分离限深、排屑、异常退出及维护因素，识别哪种机制值得进一步工程化",
        "scope": "C1/C3可作为局部台架的待比较对象，C2按测量必要性补入；不是产品优选或现场试割许可",
        "procedure": [
          "G0与客户及农艺人员确认对象、基线、测量口径和许可；未满足不得进入活树试验",
          "G1在非生物替代件上核查运动范围、接口、废物流路径及失电退出；替代件不证明真实树皮切削",
          "G2采用经许可的样本及专业监督做局部对照，独立控制旧胶线、表面曲率与刀具配置；不以同树重复刀次冒充独立样本",
          "G3在已批准边界内进行小范围真实作业，记录整周期、品质、损伤、异常与人工介入；样本规模由变异与目标差异确定",
          "G4按事先判据解释支持、反驳或不确定，保存失败与退出记录；通过对应门槛后再讨论整机"
        ],
        "measurements": [
          {
            "id": "M1",
            "observable": "切入位移、割后测量与损伤分别记录",
            "unit_or_scale": "mm及经农艺确认的损伤口径",
            "criterion": "测量定义、仪器、阈值与许可先确认；不得混用深度定义"
          },
          {
            "id": "M2",
            "observable": "新切屑、旧胶线、杂质与收集损失",
            "unit_or_scale": "按加工方认可的质量/比例和时间单位",
            "criterion": "明确采样与对照，检查隔离是否反而堵塞或失胶"
          },
          {
            "id": "M3",
            "observable": "完整作业周期与人工介入",
            "unit_or_scale": "s/株、人工min/合格产出；干胶口径待定",
            "criterion": "包括定位、切削、清理、转场与故障，不只报刀次时间"
          },
          {
            "id": "M4",
            "observable": "异常退出与恢复",
            "unit_or_scale": "受控事件记录与复位条件",
            "criterion": "先完成安全审核和非活树测试；不制造危险现场故障"
          },
          {
            "id": "M5",
            "observable": "维护和复标",
            "unit_or_scale": "min/次、错误与重试记录",
            "criterion": "清洗换刀后按已批准程序复核；阈值待操作方确认"
          }
        ],
        "uncovered_questions": [
          "短期局部测试不能证明跨周期树体健康或季节产量",
          "缺少目标平台与真实材料，尚不能给出制造尺寸和控制增益",
          "暂未完成真实用户培训、经济性与气候覆盖"
        ],
        "execution_status": "planned"
      }
